@startuml diagrama-casos-de-uso-etapa3
title Bolonha e Milano - Diagrama de casos de uso (cumulativo: Etapa 3)
left to right direction
actor Jogador

rectangle "Bolonha e Milano" {
  usecase "Iniciar novo jogo" as UC_iniciar
  usecase "Ver status da cidade" as UC_status
  usecase "Acessar mercado" as UC_mercado #FDE8C8
  usecase "Ver informações sobre o jogo" as UC_sobre
  usecase "Sair do jogo" as UC_sair
  usecase "Comprar grãos" as UC_mercado_0 #FDE8C8
  usecase "Vender grãos" as UC_mercado_1 #FDE8C8
  usecase "Comprar terras" as UC_mercado_2 #FDE8C8
  usecase "Vender terras" as UC_mercado_3 #FDE8C8
}

Jogador --> UC_iniciar
Jogador --> UC_status
Jogador --> UC_mercado
Jogador --> UC_sobre
Jogador --> UC_sair
UC_mercado_0 .> UC_mercado : <<extend>>
UC_mercado_1 .> UC_mercado : <<extend>>
UC_mercado_2 .> UC_mercado : <<extend>>
UC_mercado_3 .> UC_mercado : <<extend>>
@enduml
