@startuml diagrama-classes-etapa3
title Bolonha e Milano - Diagrama de classes (cumulativo: Etapas 1 a 3)
skinparam classAttributeIconSize 0
skinparam linetype ortho

class Main {
  + main(args: String[]): void
}

class Menu {
  - scanner: Scanner
  - emExecucao: boolean
  - jogador: Jogador
  - cidade: Cidade
  - mercado: Mercado
  --
  + executar(): void
  - exibirOpcoes(): void
  - lerOpcao(): int
  - processarOpcao(opcao: int): void
  - partidaIniciada(): boolean
  - iniciarNovoJogo(): void
  - exibirStatus(): void
  - lerQuantidade(): int
  - lerTexto(): String
  - abrirMercado(): void
  - comprarGraos(): void
  - venderGraos(): void
  - comprarTerras(): void
  - venderTerras(): void
  - exibirSobre(): void
}

class Jogador {
  - nome: String
  - titulo: String
  --
  + Jogador(nome: String)
  + getNome(): String
  + getTitulo(): String
  + setTitulo(titulo: String): void
}

class Cidade {
  - nome: String
  - anoAtual: int
  - dono: Jogador
  - florins: int
  - terras: int
  - graos: int
  --
  + Cidade(nome: String, dono: Jogador)
  + getNome() / getAnoAtual() / getDono()
  + getFlorins() / getTerras() / getGraos()
  + avancarAno(): void
  + adicionarFlorins(qtd) / removerFlorins(qtd): boolean
  + adicionarTerras(qtd) / removerTerras(qtd): boolean
  + adicionarGraos(qtd) / removerGraos(qtd): boolean
  + exibirStatus(): void
}

class Mercado #FDE8C8 {
  - PRECO_GRAO: int
  - PRECO_TERRA: int
  --
  + getPrecoGrao(): int
  + getPrecoTerra(): int
  + comprarGraos(c: Cidade, qtd: int): boolean
  + venderGraos(c: Cidade, qtd: int): boolean
  + comprarTerras(c: Cidade, qtd: int): boolean
  + venderTerras(c: Cidade, qtd: int): boolean
}

Main ..> Menu : cria e usa
Cidade --> Jogador : dono
Menu --> Jogador
Menu --> Cidade
Menu --> Mercado : mercado
Mercado ..> Cidade : usa
@enduml
