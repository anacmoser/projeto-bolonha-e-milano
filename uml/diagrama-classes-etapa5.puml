@startuml diagrama-classes-etapa5
title Bolonha e Milano - Diagrama de classes (cumulativo: Etapas 1 a 5)
skinparam classAttributeIconSize 0
skinparam linetype ortho

class Main {
  + main(args: String[]): void
}

class Menu {
  - scanner: Scanner
  - emExecucao: boolean
  - jogador: Jogador
  - cidade: Cidade
  - mercado: Mercado
  - agricultura: Agricultura
  - governo: Governo
  --
  + executar(): void
  - exibirOpcoes(): void
  - lerOpcao(): int
  - processarOpcao(opcao: int): void
  - partidaIniciada(): boolean
  - iniciarNovoJogo(): void
  - exibirStatus(): void
  - lerQuantidade(): int
  - lerTexto(): String
  - abrirMercado(): void
  - comprarGraos(): void
  - venderGraos(): void
  - comprarTerras(): void
  - venderTerras(): void
  - abrirAgricultura(): void
  - colher(): void
  - distribuirAlimentos(): void
  - abrirGoverno(): void
  - arrecadarImpostos(): void
  - definirTaxaImposto(): void
  - definirJustica(): void
  - exibirSobre(): void
}

class Jogador {
  - nome: String
  - titulo: String
  --
  + Jogador(nome: String)
  + getNome(): String
  + getTitulo(): String
  + setTitulo(titulo: String): void
}

class Cidade {
  - nome: String
  - anoAtual: int
  - dono: Jogador
  - florins: int
  - terras: int
  - graos: int
  - servos: int
  - taxaImposto: int
  - nivelJustica: String
  --
  + Cidade(nome: String, dono: Jogador)
  + getNome() / getAnoAtual() / getDono()
  + getFlorins() / getTerras() / getGraos() / getServos()
  + getTaxaImposto() / setTaxaImposto(taxa: int)
  + getNivelJustica() / setNivelJustica(nivel: String)
  + avancarAno(): void
  + adicionarFlorins(qtd) / removerFlorins(qtd): boolean
  + adicionarTerras(qtd) / removerTerras(qtd): boolean
  + adicionarGraos(qtd) / removerGraos(qtd): boolean
  + adicionarServos(qtd) / removerServos(qtd): boolean
  + exibirStatus(): void
}

class Mercado {
  - PRECO_GRAO: int
  - PRECO_TERRA: int
  --
  + getPrecoGrao(): int
  + getPrecoTerra(): int
  + comprarGraos(c: Cidade, qtd: int): boolean
  + venderGraos(c: Cidade, qtd: int): boolean
  + comprarTerras(c: Cidade, qtd: int): boolean
  + venderTerras(c: Cidade, qtd: int): boolean
}

class Agricultura {
  - HECTARES_POR_SERVO: int
  - RENDIMENTO_POR_HECTARE: int
  - SERVOS_POR_GRAO: int
  - CRESCIMENTO_PERCENTUAL: int
  - PERCENTUAL_MINIMO: int
  - PERCENTUAL_MAXIMO: int
  --
  + processarColheita(cidade: Cidade): int
  + distribuirAlimentos(cidade: Cidade, percentual: int): boolean
}

class Governo #FDE8C8 {
  - TAXA_MAXIMA: int
  - MULTIPLICADOR_JUSTA: double
  - MULTIPLICADOR_MODERADA: double
  - MULTIPLICADOR_SEVERA: double
  --
  + arrecadarImpostos(cidade: Cidade): int
  + definirTaxaImposto(cidade: Cidade, taxa: int): boolean
  + definirJustica(cidade: Cidade, nivel: String): boolean
  - multiplicadorPara(nivel: String): double
}

Main ..> Menu : cria e usa
Cidade --> Jogador : dono
Menu --> Jogador
Menu --> Cidade
Menu --> Mercado : mercado
Mercado ..> Cidade : usa
Menu --> Agricultura : agricultura
Agricultura ..> Cidade : usa
Menu --> Governo : governo
Governo ..> Cidade : usa
@enduml
