@startuml diagrama-classes-etapa8
title Bolonha e Milano - Diagrama de classes (cumulativo: Etapas 1 a 8)
skinparam classAttributeIconSize 0

class Main {
  + main(args: String[]): void
}

class Menu {
  - scanner: Scanner
  - emExecucao: boolean
  - partida: Partida
  - cidade: Cidade
  - mercado: Mercado
  - agricultura: Agricultura
  - governo: Governo
  - construcoes: Construcoes
  - nobreza: Nobreza
  --
  + executar(): void
  - exibirOpcoes(): void
  - lerOpcao(): int
  - lerQuantidade(): int
  - lerInteiro(): int
  - exigirJogoEmAndamento(): boolean
  - lerTexto(): String
  - processarOpcao(opcao: int): void
  - descricaoDaVez(): String
  - iniciarNovoJogo(): void
  - exibirStatus(): void
  - abrirMercado(): void  (+ 4 operações)
  - abrirAgricultura(): void  (+ 2 operações)
  - abrirGoverno(): void  (+ 3 operações)
  - abrirConstrucoes(): void  (+ 2 operações)
  - encerrarTurno(): void
  - exibirClassificacao(): void
  - encerrarPartida(): void
  - exibirSobre(): void
}

class Partida {
  + MAXIMO_JOGADORES: int = 4 {static}
  - ANO_FINAL: int = 1410 {static}
  - cidades: List<Cidade>
  - indiceAtual: int
  --
  + adicionarCidade(cidade): boolean
  + getCidades(): List<Cidade>
  + getCidadeAtual(): Cidade
  + getAnoAtual(): int / getAnoFinal(): int
  + passarTurno(): boolean
  + encerrarAno(nobreza): List<Cidade>
  + terminou(): boolean
  + determinarVencedor(nobreza): Cidade
}

class Jogador {
  - TITULOS: String[] {static}
  - nome: String
  - nivelTitulo: int
  --
  + Jogador(nome)
  + getNome(): String
  + getTitulo(): String
  + getNivelTitulo(): int
  + promover(): boolean
  + ehMonarca(): boolean
}

class Cidade {
  - nome: String
  - anoAtual: int
  - dono: Jogador
  - florins / terras / graos / servos: int
  - taxaImposto: int
  - nivelJustica: String
  - soldados / construcoes: int
  - colheitaFeita: boolean
  - impostosArrecadados: boolean
  --
  + getNome() / getAnoAtual() / getDono()
  + get* dos recursos e configurações
  + setTaxaImposto(taxa) / setNivelJustica(nivel)
  + isColheitaFeita() / marcarColheitaFeita()
  + isImpostosArrecadados() / marcarImpostosArrecadados()
  + avancarAno(): void
  + adicionar*(qtd) / remover*(qtd): boolean
  + exibirStatus(): void
}

class Mercado {
  - PRECO_GRAO: int
  - PRECO_TERRA: int
  --
  + getPrecoGrao() / getPrecoTerra(): int
  + comprarGraos / venderGraos(c, qtd): boolean
  + comprarTerras / venderTerras(c, qtd): boolean
}

class Agricultura {
  - HECTARES_POR_SERVO / RENDIMENTO_POR_HECTARE / SERVOS_POR_GRAO: int
  - CRESCIMENTO_PERCENTUAL / PERCENTUAL_MINIMO / PERCENTUAL_MAXIMO: int
  --
  + processarColheita(cidade): int  (-1 se já colheu)
  + distribuirAlimentos(cidade, %): boolean
}

class Governo {
  - TAXA_MAXIMA: int
  - MULTIPLICADOR_JUSTA / MODERADA / SEVERA: double
  --
  + arrecadarImpostos(cidade): int  (-1 se já arrecadou)
  + definirTaxaImposto(cidade, taxa): boolean
  + definirJustica(cidade, nivel): boolean
  - multiplicadorPara(nivel): double
}

class Construcoes {
  - PRECO_SOLDADO / SERVOS_POR_SOLDADO / PRECO_CONSTRUCAO: int
  --
  + recrutarSoldados(cidade, qtd): boolean
  + construir(cidade, qtd): boolean
  + getPrecoSoldado() / getPrecoConstrucao(): int
}

class Nobreza {
  - PESO_CONSTRUCAO: int = 10
  - PESO_SOLDADO: int = 2
  - PESO_SERVO: int = 1
  - HECTARES_POR_PONTO: int = 100
  - PRESTIGIO_MINIMO: int[]
  --
  + calcularPrestigio(cidade): int
  + prestigioParaProximoTitulo(jogador): int
  + verificarPromocao(cidade): boolean
}

class Testes #FDE8C8 {
  - aprovados: int {static}
  - reprovados: int {static}
  --
  + main(args: String[]): void {static}
  - verificar(descricao, condicao): void {static}
  - novaCidade(): Cidade {static}
  - testarCidade() / testarMercado() / testarAgricultura(): void
  - testarGoverno() / testarConstrucoes(): void
  - testarJogadorENobreza() / testarPartida(): void
}

Main ..> Menu : cria e usa
Cidade --> Jogador : dono
Menu --> Partida : partida
Partida --> Cidade : cidades 1..4
Menu --> Cidade : vez atual
Menu --> Mercado : mercado
Mercado ..> Cidade : usa
Menu --> Agricultura : agricultura
Agricultura ..> Cidade : usa
Menu --> Governo : governo
Governo ..> Cidade : usa
Menu --> Construcoes : construcoes
Construcoes ..> Cidade : usa
Menu --> Nobreza : nobreza
Nobreza ..> Cidade : usa
Nobreza ..> Jogador
Partida ..> Nobreza : usa
Testes ..> Cidade : testa
Testes ..> Mercado
Testes ..> Agricultura
Testes ..> Governo
Testes ..> Construcoes
Testes ..> Nobreza
Testes ..> Partida
@enduml
